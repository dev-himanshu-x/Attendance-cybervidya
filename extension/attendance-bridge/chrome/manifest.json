{
	"manifest_version": 3,
	"name": "Attendance Bridge",
	"version": "4.6",
	"description": "Lets the Attendance website read your CyberVidya attendance through your own browser.",
	"icons": {
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["storage", "alarms", "scripting", "offscreen"],
	"host_permissions": [
		"https://kiet.cybervidya.net/*",
		"https://cyberviydakiet.vercel.app/*",
		"http://localhost/*",
		"http://127.0.0.1/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://cyberviydakiet.vercel.app/*",
				"http://localhost/*",
				"http://127.0.0.1/*"
			],
			"js": ["content.js"],
			"run_at": "document_start"
		},
		{
			"matches": ["https://kiet.cybervidya.net/*"],
			"js": ["content.js"],
			"run_at": "document_end",
			"all_frames": true
		}
	],
	"background": {
		"service_worker": "background.js"
	}
}
